* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf

# Browser and repository text files
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Binary source and evidence artifacts
[attr]lfs filter=lfs diff=lfs merge=lfs -text

# 3D models and authoring sources
*.3dm lfs
*.3ds lfs
*.blend lfs
*.c4d lfs
*.collada lfs
*.dae lfs
*.dxf lfs
*.FBX lfs
*.fbx lfs
*.gltf text eol=lf
*.lws lfs
*.lxo lfs
*.ma lfs
*.max lfs
*.mb lfs
*.obj lfs
*.ply lfs
*.skp lfs
*.stl lfs
*.ztl lfs

# Audio and video
*.aif lfs
*.aiff lfs
*.flac lfs
*.mp3 lfs
*.ogg lfs
*.wav lfs
*.avi lfs
*.mov lfs
*.mp4 lfs
*.mpeg lfs
*.mpg lfs
*.webm lfs

# Images and design sources
*.bmp lfs
*.exr lfs
*.gif lfs
*.hdr lfs
*.jpeg lfs
*.jpg lfs
*.png lfs
*.psd lfs
*.svg text eol=lf
*.tga lfs
*.tif lfs
*.tiff lfs
*.webp lfs

# Archives, fonts, documents and compiled binaries
*.7z lfs
*.bz2 lfs
*.gz lfs
*.rar lfs
*.tar lfs
*.zip lfs
*.dll lfs
*.pdb lfs
*.so lfs
*.otf lfs
*.ttf lfs
*.pdf lfs
*.exe lfs
