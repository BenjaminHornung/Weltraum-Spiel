* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf

# Browser and repository text files
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Binary source and evidence artifacts
[attr]lfs filter=lfs diff=lfs merge=lfs -text

# 3D models and authoring sources
*.3dm lfs
*.3ds lfs
*.blend lfs
*.c4d lfs
*.collada lfs
*.dae lfs
*.dxf lfs
*.FBX lfs
*.fbx lfs
*.gltf text eol=lf
*.lws lfs
*.lxo lfs
*.ma lfs
*.max lfs
*.mb lfs
*.obj lfs
*.ply lfs
*.skp lfs
*.stl lfs
*.ztl lfs

# Audio and video
*.aif lfs
*.aiff lfs
*.flac lfs
*.mp3 lfs
*.ogg lfs
*.wav lfs
*.avi lfs
*.mov lfs
*.mp4 lfs
*.mpeg lfs
*.mpg lfs
*.webm lfs

# Images and design sources
*.bmp lfs
*.exr lfs
*.gif lfs
*.hdr lfs
*.jpeg lfs
*.jpg lfs
*.png lfs
*.psd lfs
*.svg text eol=lf
*.tga lfs
*.tif lfs
*.tiff lfs
*.webp lfs

# Archives, fonts, documents and compiled binaries
*.7z lfs
*.bz2 lfs
*.gz lfs
*.rar lfs
*.tar lfs
*.zip lfs
*.dll lfs
*.pdb lfs
*.so lfs
*.otf lfs
*.ttf lfs
*.pdf lfs
*.exe lfs

# Owner-approved crashsite candidate; retain exact native/runtime payloads in LFS.
art/factory/crashsite-hybrid-v1/*.glb lfs
apps/weltraum-browser/public/factory/crashsite-hybrid-v1/*.glb lfs
art/factory/crashsite-hybrid-v2/*.glb lfs
apps/weltraum-browser/public/factory/crashsite-hybrid-v2/*.glb lfs

# Published Play GLBs are runtime payloads and must clone from Git LFS.
apps/weltraum-browser/public/factory/play-2026-10-12/*.glb lfs

# Byte-pinned derivative and walkability receipts must not be line-ending normalized.
apps/weltraum-browser/public/factory/play-2026-10-12/manifest-cargo-surface-v2.json -text
apps/weltraum-browser/public/factory/play-2026-10-12/manifest-distribution-surface-v2.json -text
art/factory/crashsite-walkable-v1-2026-10-19/AUTHORING_REPORT.json -text
art/factory/crashsite-walkable-v1-2026-10-19/WALKABILITY_VALIDATION.json -text
art/factory/play-cargo-surface-v2-2026-10-19/manifest.json -text
art/factory/play-cargo-surface-v2-2026-10-19/wreck_cargo_open_v2.provenance.json -text
art/factory/play-cargo-surface-v2-2026-10-19/wreck_cargo_v2.provenance.json -text
art/factory/play-distribution-surface-v2-2026-10-21/distribution-v2.provenance.json -text
art/factory/play-distribution-surface-v2-2026-10-21/manifest.json -text
