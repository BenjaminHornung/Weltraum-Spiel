  "decisions": [
    {
      "id": "D01",
      "proposal": "0.25-m placement grid; terrain cell size remains read from the 0.125-m versioned HVP source. No terrain migration.",
      "status": "PROPOSED_OWNER_REVIEW_REQUIRED",
      "ownerApprovalEvidence": null
    },
    {
      "id": "D02",
      "proposal": "Resources snapshots remain sole cargo authority; exact factory admissions, indivisible components and explicit rejection for nonrepresentable quantities.",
      "status": "PROPOSED_OWNER_REVIEW_REQUIRED",
      "ownerApprovalEvidence": null
    },
    {
      "id": "D03",
      "proposal": "FP01 factory electrical priorities/reserves in a local allocator; existing ship solver semantics unchanged.",
      "status": "PROPOSED_OWNER_REVIEW_REQUIRED",
      "ownerApprovalEvidence": null
    },
    {
      "id": "D04",
      "proposal": "New combined factory checkpoint and slot namespace using existing atomic repository; legacy HVP slots unchanged.",
      "status": "PROPOSED_OWNER_REVIEW_REQUIRED",
      "ownerApprovalEvidence": null
    },
    {
      "id": "D05",
      "proposal": "100-ms factory step bound to confirmed host/physics and universe ticks, without independent wall-clock progress.",
      "status": "PROPOSED_OWNER_REVIEW_REQUIRED",
      "ownerApprovalEvidence": null
    },
    {
      "id": "D06",
      "proposal": "Powered belt accrues 1 kg/s, starts at zero, caps credit at 10 kg and persists it; nominal long-term 60 kg/min, not a strict sliding-window cap.",
      "status": "PROPOSED_OWNER_REVIEW_REQUIRED",
      "ownerApprovalEvidence": null
    },
    {
      "id": "D07",
      "proposal": "Separate /factory.html entry within current browser package; main.ts unchanged.",
      "status": "PROPOSED_OWNER_REVIEW_REQUIRED",
      "ownerApprovalEvidence": null
    },
    {
      "id": "D08",
      "proposal": "Atomic mining material participant in existing terrain commit. Outside W00-W11.",
      "status": "DEFERRED_OUT_OF_SCOPE",
      "ownerApprovalEvidence": null
    },
    {
      "id": "D09",
      "proposal": "Replay-safe bounded receipt protocol. Outside W00-W11.",
      "status": "DEFERRED_OUT_OF_SCOPE",
      "ownerApprovalEvidence": null
    },
    {
      "id": "D10",
      "proposal": "Existing global test and CI timeouts unchanged; segmented UI tests and separate full-duration evidence.",
      "status": "PROPOSED_OWNER_REVIEW_REQUIRED",
      "ownerApprovalEvidence": null
    },
    {
      "id": "D11",
      "proposal": "Bounded fixed facility owners in the same native world, prepare/commit/publish/rollback/finalize and complete combined checkpoint; proposed 16-owner admission is not approved.",
      "status": "PROPOSED_OWNER_REVIEW_REQUIRED",
      "ownerApprovalEvidence": null
    }
  ],
