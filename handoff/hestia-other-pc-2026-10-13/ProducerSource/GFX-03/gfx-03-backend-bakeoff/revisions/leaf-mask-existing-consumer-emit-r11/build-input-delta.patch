+  ['package-lock.json', 'dist/source-package-lock.json']
+]) await cp(from, to, { recursive: true, errorOnExist: true, force: false });
+
+const sourcePackage = JSON.parse(await readFile('package.json', 'utf8'));
+const exports = {};
