--- /dev/null
+++ b/spikes/rt-02b-dda/src/eligibility.mts
@@ -0,0 +1,43 @@
+// Source candidate only: deliberately bounded functional-trial domain, not GPU qualification.
+export type TrialDomain =
+  | { status: 'UNSUPPORTED'; reason: string }
+  | { status: 'ELIGIBLE_FOR_FUNCTIONAL_TRIAL'; shaderIterations: 256; cellIntervalBound: number; conservativeIterationBound: number };
+
+export function assessGpuTrialDomain(
+  size: readonly number[], cellMeters: number, gridOrigin: readonly number[],
+  gridDirection: readonly number[], maxDistance: number,
+): TrialDomain {
+  const unsupported = (reason: string): TrialDomain => ({ status: 'UNSUPPORTED', reason });
+  if (size.length !== 3 || !size.every(n => Number.isSafeInteger(n) && n > 0 && n <= 64))
+    return unsupported('GRID_OUTSIDE_BOUND_1_TO_64_PER_AXIS');
+  if (cellMeters !== 0.125 && cellMeters !== 0.25) return unsupported('UNBOUND_CELL_SIZE');
+  const sum = size.reduce((a, b) => a + b, 0);
+  if (sum + 3 > 256) return unsupported('UNPROVEN_SHADER_ITERATION_DOMAIN');
+  if (gridOrigin.length !== 3 || gridDirection.length !== 3
+    || ![...gridOrigin, ...gridDirection, maxDistance].every(Number.isFinite))
+    return unsupported('NONFINITE_OR_UNKNOWN_RELATIVE_FRAME');
+  if (gridOrigin.some(n => Math.abs(n) > 65536)) return unsupported('RELATIVE_FRAME_OUT_OF_BOUNDS');
+  // No quantization: reject values rather than move a ray or change a Golden.
+  if (gridOrigin.some(n => !Number.isSafeInteger(n * 16) || Math.fround(n) !== n))
+    return unsupported('NON_DYADIC_GRID_ORIGIN');
+  const active = gridDirection.filter(n => n !== 0);
+  if (active.length !== 1 || Math.abs(active[0]!) !== 1 / cellMeters)
+    return unsupported('NON_AXIAL_OR_UNPROVEN_TIE_DOMAIN');
+  if (maxDistance <= 0 || maxDistance > 65536
+    || !Number.isSafeInteger(maxDistance * 128) || Math.fround(maxDistance) !== maxDistance)
+    return unsupported('NON_DYADIC_DISTANCE_HORIZON');
+  return {
+    status: 'ELIGIBLE_FOR_FUNCTIONAL_TRIAL', shaderIterations: 256,
+    cellIntervalBound: sum - 2, conservativeIterationBound: sum + 3,
+  };
+}
+
+export class GpuQueryUnsupported extends Error {
+  readonly status = 'UNSUPPORTED';
+  readonly rayId: string;
+  readonly reason: string;
+  constructor(rayId: string, reason: string) {
+    super('Unsupported GPU query ' + rayId + ': ' + reason);
+    this.rayId = rayId; this.reason = reason;
+  }
+}
