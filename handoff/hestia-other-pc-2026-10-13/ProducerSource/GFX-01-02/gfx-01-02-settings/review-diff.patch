+  const env = { ...process.env, TMP: temp, TEMP: temp, PATH: dirname(process.execPath) + ';' + process.env.PATH };
+  const checks = [];
+  for (const [name, args] of [
+    ['typecheck', ['node_modules/typescript/bin/tsc', '--noEmit']],
