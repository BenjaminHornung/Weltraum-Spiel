+  const priority={Unknown:0,BudgetExceeded:1,Hit:2,Miss:3};
+  const sorted=hits.filter(h=>h.result.kind!=='Miss').sort((a,b)=>a.result.distance-b.result.distance||priority[a.result.kind]-priority[b.result.kind]||String(a.result.owner).localeCompare(String(b.result.owner),'en'));
+  const primitive=sorted[0]??hits[0]??null;
+  const empty:RayResult={kind:'Miss',distance:ray.maxDistance,normal:[0,0,0],cell:null,materialId:null,materialSource:null,owner:null,cellId:null,sourceRevision:null,sourceGeneration:null,transformGeneration:null,originEpoch:null};
+  return Object.freeze({result:primitive?.result??empty,primitive,sourceBindings:this.bindings,serial:this.#serial,deviceEpoch:this.#deviceEpoch,mode,queryScope:'FINITE_CONTACT_SEGMENT_NOT_WORLD_AIR',gpuMilliseconds:null});
+ }
+ resources(){return {...(this.#current?.resources()??{retainedGenerations:0,bvhGeometries:0,sparseOwners:0,typedCpuBytes:0}),pendingGenerations:this.#pending?.resources().retainedGenerations??0,
+  backlog:Number(this.#preparing),cpuByteScope:'TYPED_BUFFERS_ONLY_JS_HEAP_NOT_MEASURED',gpuBytes:null};}
+ reset(deviceEpoch=this.#deviceEpoch){
+  this.#live();if(!Number.isSafeInteger(deviceEpoch)||deviceEpoch<this.#deviceEpoch)throw new Error('Invalid device epoch');
+  this.#serial++;this.#deviceEpoch=deviceEpoch;this.#set.reset();this.#current?.dispose();this.#pending?.dispose();this.#current=this.#pending=null;this.#expected=[];this.#hasPrimary=false;
+  this.#timing={t_source_commit:null,t_primary_render:null,t_ray_adopt:null,t_lighting_current:null,gpuMilliseconds:null};
+ }
+ dispose(){if(this.#disposed)return false;this.reset();this.#disposed=true;return true;}
+}
