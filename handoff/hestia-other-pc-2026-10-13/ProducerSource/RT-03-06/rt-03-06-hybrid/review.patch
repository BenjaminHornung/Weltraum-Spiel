+export function currentSunDirection(sun:T.DirectionalLight):[number,number,number]{
+ const direction=sun.getWorldPosition(new T.Vector3()).sub(sun.target.getWorldPosition(new T.Vector3()));if(!Number.isFinite(direction.length())||direction.length()===0)throw new Error('Invalid actual sun direction');return direction.normalize().toArray();
+}
+export function validateRasterSlice(scene:T.Scene,sun:T.DirectionalLight,ambient:T.AmbientLight){
