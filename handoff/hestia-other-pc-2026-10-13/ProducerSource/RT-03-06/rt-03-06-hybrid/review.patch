+ dispose(){if(this.#released)return false;this.#released=true;for(const o of this.owners){o.bvh.dispose();o.dda.dispose();}return true;}
+ get released(){return this.#released;}
+}
+/** Finite snapshot replay only. The caller's current primary snapshot is the adoption oracle. */
+export class DynamicProjection {
+ #expected:Volume[]=[];#hasPrimary=false;#serial=0;#deviceEpoch=0;#disposed=false;#preparing=false;
+ #current:PreparedProjection|null=null;#pending:PreparedProjection|null=null;#token=Symbol('owned replay');#set=new ProjectionSet();
+ #timing:{t_source_commit:number|null;t_primary_render:number|null;t_ray_adopt:number|null;t_lighting_current:number|null;gpuMilliseconds:null}=
+  {t_source_commit:null,t_primary_render:null,t_ray_adopt:null,t_lighting_current:null,gpuMilliseconds:null};
+ #live(){if(this.#disposed)throw new Error('Disposed dynamic projection');}
+ setPrimary(volumes:readonly Volume[],knownEmpty=false){
+  this.#live();if(!volumes.length&&!knownEmpty)throw new Error('Explicit known-empty coverage required');
+  const next=structuredClone(volumes) as Volume[];next.forEach(validateVolume);assertExclusiveOwners(next);
+  const owners=new Set(next.map(v=>v.binding.owner));if(owners.size!==next.length)throw new Error('Duplicate source owner');
+  this.#expected=frozen(next);this.#hasPrimary=true;this.#serial++;this.#pending?.dispose();this.#pending=null;
+  this.#timing={t_source_commit:performance.now(),t_primary_render:null,t_ray_adopt:null,t_lighting_current:null,gpuMilliseconds:null};
+ }
+ get bindings(){return frozen(this.#expected.map(v=>({...v.binding})));}
+ get serial(){return this.#serial;}
+ get deviceEpoch(){return this.#deviceEpoch;}
+ get telemetry(){return Object.freeze({...this.#timing,clock:'PERFORMANCE_NOW_SYNTHETIC_REPLAY_DIAGNOSTIC',qualified:false});}
+ markPrimaryRender(serial=this.#serial){this.#live();if(serial!==this.#serial||!this.#hasPrimary)throw new Error('Stale primary render');this.#timing.t_primary_render=performance.now();}
+ markLightingCurrent(serial=this.#serial){this.#assertCurrent();if(serial!==this.#serial)throw new Error('Stale lighting');this.#timing.t_lighting_current=performance.now();}
