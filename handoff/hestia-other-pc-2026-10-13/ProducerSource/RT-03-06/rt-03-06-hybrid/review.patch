+struct Input { direct:vec4f, indirect:vec4f, emissive:vec4f, factor:vec4f }
+@group(0) @binding(0) var<storage,read> pixels:array<Input>;
+@group(0) @binding(1) var<storage,read_write> result:array<vec4f>;
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id:vec3u) {
+ if(id.x>=arrayLength(&pixels)){return;}
+ let p=pixels[id.x];
+ // Mandatory block AO is already in input radiance; optional screen/ray AO is replaced on indirect only.
+ let factor=clamp(p.factor.x,0.0,1.0);
+ result[id.x]=vec4f(p.direct.xyz+p.indirect.xyz*factor+p.emissive.xyz,1.0);
+}
