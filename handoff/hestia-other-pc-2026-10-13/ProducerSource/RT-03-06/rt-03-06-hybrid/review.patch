+import type {Binding,Volume,Ray,RayResult} from '../inputs/rt01/src/types.mts';
+import {validateVolume,validateRay,assertCurrent,assertExclusiveOwners} from '../inputs/rt01/src/validate.mts';
+import {BvhRayBackend} from '../inputs/rt02a/src/backend.js';
+import {createSparseVolume,prepareDirty,ProjectionSet,type SparseVolume} from '../inputs/rt02b/src/sparse.mts';
+import {primitiveHit} from '../inputs/rt02b/src/port.mts';
