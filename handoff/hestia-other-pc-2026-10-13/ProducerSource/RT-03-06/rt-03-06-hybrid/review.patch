+        positionLocal.z.sub(materialUniforms.wind.x.mul(positionLocal.y)));
+    }
+    if(water){
+      const ripple=normalize(vec3(sin(p.x.mul(3.1).add(p.z.mul(1.7))).mul(0.09).add(cos(p.z.mul(8)).mul(0.035)),
