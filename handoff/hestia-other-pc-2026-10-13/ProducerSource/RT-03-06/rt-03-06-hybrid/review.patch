+/** Finite diagnostic decomposition, same renderer/material/depth. Caller serializes the borrowed host. */
+export async function captureRaster(host:RasterHost,target:ReturnType<typeof rasterTarget>,frame:HistoryFrame):Promise<GBuffer>{
