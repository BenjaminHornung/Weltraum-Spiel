+export async function runCpuBrowser(){
+ const {goldens,volumes}=await inputs(),projection=new DynamicProjection();let checks=0;
+ try{for(const v of volumes){projection.setPrimary([v]);projection.adopt(await projection.prepare());for(const row of goldens.filter((r:any)=>r.volumeId===v.id))for(const mode of ['bvh','flat','two-level'] as const){
+   const actual=projection.query(row.ray,mode).result;if(Math.abs(actual.distance-row.expected.distance)>1e-9||actual.normal.some((n,i)=>Math.abs(n-row.expected.normal[i])>1e-9)||Object.keys(row.expected).some(k=>k!=='distance'&&k!=='normal'&&JSON.stringify((actual as any)[k])!==JSON.stringify(row.expected[k])))throw new Error('Browser CPU oracle mismatch');checks++;
+  }}return {status:'PASS',checks,backend:'CPU_IN_REAL_BROWSER',gpu:'NOT_RUN',actualAdapter:null,gpuMilliseconds:null,productIntegration:'NO'};}finally{projection.dispose();}
+}
+export async function runBoundHardware(host:HardwareHost,lease:RunnerLease){
+ const sealResponse=await fetch('./seal-envelope.json');if(!sealResponse.ok)throw new Error('Sealed server control unavailable');const sealBytes=new Uint8Array(await sealResponse.arrayBuffer());if(await digest(sealBytes)!==lease.sealSha256)throw new Error('Outer seal bytes drift');
