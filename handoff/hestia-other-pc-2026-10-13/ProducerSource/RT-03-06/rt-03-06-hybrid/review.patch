+import type {RasterPixel} from './hybrid.mts';
+import {composeLinear} from './hybrid.mts';
+import type {HistoryPixel} from './history.mts';
+export class GpuLinearCompose {
+ #disposed=false;#lost=false;#busy=false;
+ private constructor(private readonly device:GPUDevice,private readonly pipeline:GPUComputePipeline){void device.lost.then(()=>{this.#lost=true;});}
+ static async create(device:GPUDevice,source:string){
+  device.pushErrorScope('validation');let pipeline:GPUComputePipeline|undefined,failure:unknown;
+  try{const shader=device.createShaderModule({code:source,label:'RT0306 linear indirect-only compose'}),info=await shader.getCompilationInfo();if(info.messages.some(m=>m.type==='error'))throw new Error(info.messages.map(m=>m.message).join('\n'));pipeline=await device.createComputePipelineAsync({layout:'auto',compute:{module:shader,entryPoint:'main'}});}catch(e){failure=e;}
+  const error=await device.popErrorScope();if(error||failure||!pipeline)throw failure??new Error(error?.message??'No compose pipeline');return new GpuLinearCompose(device,pipeline);
+ }
+ async run(pixels:readonly RasterPixel[],contact:readonly Pick<HistoryPixel,'status'|'occlusion'>[],mode:'shadowmap'|'screen-AO'|'contact',assertLive:()=>void){
+  if(this.#disposed||this.#lost||this.#busy)throw new Error('Unavailable compose lifetime');if(!pixels.length||pixels.length>4096||contact.length!==pixels.length)throw new Error('Finite compose count');
