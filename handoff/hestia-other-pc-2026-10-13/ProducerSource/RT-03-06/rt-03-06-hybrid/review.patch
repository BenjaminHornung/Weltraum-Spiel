+ if(replayManifest.sha256!=='9d36ca1ce2e92350c81f40fbdea15797db972481bc7fb0188b1950921464fd9e')throw new Error('Untrusted replay manifest');
+ return {goldens:files.get('rays/golden-1000.json'),volumes:[...files].filter(([name])=>name.startsWith('voxels/')).map(([,v])=>v as Volume),replay:replay.events};
