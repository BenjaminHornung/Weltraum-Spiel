+   candidate.owners.forEach((o,i)=>{assertCurrent(o.volume.binding,this.#expected[i].binding);assertCurrent(o.bvh.snapshot().binding,this.#expected[i].binding);assertCurrent(o.dda.binding,this.#expected[i].binding);});
