+  sun.visible=false;ambient.visible=true;renderer.render(scene,camera);indirect=await read(0);
+ }finally{sun.visible=previousSun;ambient.visible=previousAmbient;renderer.setMRT(previousMrt);renderer.setRenderTarget(previousTarget);renderer.setClearColor(previousClear,previousAlpha);}
+ const pixels:RasterPixel[]=Array.from({length:frame.width*frame.height},(_,i)=>{
+  const p=i*4,owner=identity[p],material=identity[p+1],background=identity[p+2]<.5;
+  if(!background&&(!Number.isInteger(owner)||!Number.isInteger(material)||!host.owners[owner-1]||!host.materials[material-1]))throw new Error('Invalid MRT Primitive identity');
+  const n=background?[0,0,0]:Array.from(normal.slice(p,p+3)),norm=Math.hypot(...n);if(!background&&norm===0)throw new Error('Invalid MRT normal');
