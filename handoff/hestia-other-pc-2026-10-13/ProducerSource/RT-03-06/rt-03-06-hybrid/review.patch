+}
+/** Same GFX output-quad pattern; caller retains its one primary renderer and final ACES pass. */
+export function drawLinearOutput(renderer:WebGPURenderer,width:number,height:number,linear:readonly (readonly number[])[]){
+ if(linear.length!==width*height||linear.some(c=>c.length!==3||c.some(v=>!Number.isFinite(v)||v<0)))throw new Error('Invalid final linear radiance');
+ const data=new Float32Array(width*height*4);linear.forEach((c,i)=>data.set([...c,1],i*4));
+ const map=new T.DataTexture(data,width,height,T.RGBAFormat,T.FloatType);map.colorSpace=T.LinearSRGBColorSpace;map.needsUpdate=true;
+ const material=new MeshBasicNodeMaterial();material.colorNode=texture(map,uv().flipY());material.depthTest=false;material.depthWrite=false;
+ const geometry=new T.PlaneGeometry(2,2),scene=new T.Scene(),camera=new T.OrthographicCamera(-1,1,1,-1,0,1);scene.add(new T.Mesh(geometry,material));
+ const release=()=>{map.dispose();material.dispose();geometry.dispose();};
+ const previous=renderer.getRenderTarget(),previousMrt=renderer.getMRT();
