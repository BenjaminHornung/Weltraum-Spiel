+import {runHardwareProfile,type HardwareHost,type RunnerLease} from './runner.mts';
+import type {Volume} from '../inputs/rt01/src/types.mts';
+const expectedFixture='bc6e9be728c932b0fe6f88ea2d6024f61b2b53bc59d47aae0e941c499a34dbea';
+async function checked(url:string,expected:string){const response=await fetch(url);if(!response.ok)throw new Error('Missing served input '+url);const bytes=new Uint8Array(await response.arrayBuffer());if(await digest(bytes)!==expected)throw new Error('Served input byte drift '+url);return JSON.parse(new TextDecoder().decode(bytes));}
