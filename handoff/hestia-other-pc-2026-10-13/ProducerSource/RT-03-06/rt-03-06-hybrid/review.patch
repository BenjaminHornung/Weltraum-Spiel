+ if(scene.environment||scene.fog||scene.overrideMaterial||nodes.environmentNode||nodes.backgroundNode||nodes.fogNode||scene.background&&(!(scene.background instanceof T.Color)||scene.background.getHex()!==0))throw new Error('Unsupported shared background/environment/fog energy');
