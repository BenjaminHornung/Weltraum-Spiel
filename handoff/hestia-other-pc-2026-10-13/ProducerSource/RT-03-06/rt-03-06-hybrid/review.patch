+   const old=this.#current;this.#current=candidate;this.#pending=null;old?.dispose();this.#timing.t_ray_adopt=performance.now();return true;
+  }catch(e){if(candidate.issuer===this.#token&&candidate!==this.#current)candidate.dispose();throw e;}
+ }
+ #assertCurrent(){
+  this.#live();if(!this.#current||this.#current.serial!==this.#serial||this.#current.deviceEpoch!==this.#deviceEpoch)throw new Error('No current ray lighting projection');
+  this.#current.owners.forEach((o,i)=>assertCurrent(o.volume.binding,this.#expected[i].binding));return this.#current;
+ }
+ query(ray:Ray,mode:RayMode){
+  validateRay(ray);if(!['bvh','flat','two-level'].includes(mode))throw new Error('Invalid ray backend');const current=this.#assertCurrent();
+  const hits=current.owners.map(o=>{const query=mode==='bvh'?{result:o.bvh.query(ray,o.volume.binding,'ClosestHit',this.#deviceEpoch),counters}:o.dda.traceFrozen(ray,o.volume.binding,mode);
