+import {mrt,output,positionWorld,normalWorld,positionView,float,vec4,texture,uv} from 'three/tsl';
+import {surfaceMaterial} from '../inputs/gfx03/src/materials.js';
+import {createDepthCameraPort,lightDepthPolicy,type MaterialData} from '../inputs/gfx03/src/port.js';
+import type {HistoryFrame} from './history.mts';
+import type {GBuffer,RasterPixel} from './hybrid.mts';
+import {assertFrameCurrent} from './hybrid.mts';
+/** Patch candidate on the frozen GFX material: only extra MRT identity outputs are added. */
+export function taggedGfxMaterial(data:MaterialData,ownerIndex:number,materialIndex:number){
+ if(!Number.isSafeInteger(ownerIndex)||ownerIndex<1||!Number.isSafeInteger(materialIndex)||materialIndex<1)throw new Error('Invalid MRT surface identity');
+ const material=surfaceMaterial(T,true,data,false,false) as MeshStandardNodeMaterial;
+ material.mrtNode=mrt({identity:vec4(float(ownerIndex),float(materialIndex),float(1),float(1))});return material;
+}
+export function rasterTarget(width:number,height:number){
+ if(!Number.isSafeInteger(width)||!Number.isSafeInteger(height)||width<1||height<1||width*height>4096)throw new Error('Finite raster target cap');
+ const target=new T.RenderTarget(width,height,{count:4,type:T.HalfFloatType,depthBuffer:true,minFilter:T.NearestFilter,magFilter:T.NearestFilter});
+ ['output','worldPosition','normalDepth','identity'].forEach((name,i)=>{target.textures[i].name=name;target.textures[i].colorSpace=T.LinearSRGBColorSpace;});
+ target.depthTexture=new T.DepthTexture(width,height,T.UnsignedIntType);return target;
+}
