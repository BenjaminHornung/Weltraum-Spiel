+  pixels.forEach((p,i)=>{const factor=mode==='shadowmap'?1:mode==='screen-AO'?1-p.screenAo:contact[i].status==='CURRENT'?1-contact[i].occlusion:1;data.set([...p.direct,0,...p.indirect,0,...p.emissive,0,factor,0,0,0],i*16);});
+  if(data.byteLength>this.device.limits.maxStorageBufferBindingSize||data.byteLength>this.device.limits.maxBufferSize)throw new Error('Compose device limit');
+  const buffers:GPUBuffer[]=[];this.device.pushErrorScope('validation');this.#busy=true;let failure:unknown,values:number[][]|undefined,querySet:GPUQuerySet|undefined,gpuMilliseconds:number|null=null,timestampNanoseconds:string[]|null=null;
+  const live=()=>{assertLive();if(this.#disposed||this.#lost)throw new Error('Lost compose lifetime');};
+  const create=(size:number,usage:number)=>{const b=this.device.createBuffer({size,usage});buffers.push(b);return b;};
