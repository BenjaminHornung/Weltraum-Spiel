+const same=(a:unknown,b:unknown)=>JSON.stringify(a)===JSON.stringify(b);
+function dirtyPages(a:Volume,b:Volume){
+ const ps=a.size.map(n=>Math.ceil(n/8)),changed=new Set<number>();
+ a.cells.forEach((slot,i)=>{if(slot===b.cells[i])return;const x=i%a.size[0],y=Math.floor(i/a.size[0])%a.size[1],z=Math.floor(i/(a.size[0]*a.size[1]));changed.add(Math.floor(x/8)+ps[0]*(Math.floor(y/8)+ps[1]*Math.floor(z/8)));});
+ return [...changed].sort((x,y)=>x-y);
+}
+function canDirty(a:Volume,b:Volume){
+ return ['domain','world','session','epoch','owner','frame','originEpoch','transformGeneration','materialDigest','algorithm'].every(k=>a.binding[k as keyof Binding]===b.binding[k as keyof Binding])&&
+  b.binding.sourceRevision>a.binding.sourceRevision&&b.binding.sourceGeneration>a.binding.sourceGeneration&&
