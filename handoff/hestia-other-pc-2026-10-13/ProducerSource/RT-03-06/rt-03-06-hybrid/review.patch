--- /dev/null
+++ b/spikes/rt-03-06-hybrid/inputs/rt02b/src/dda.wgsl
@@ -0,0 +1,72 @@
+// Frozen positive-interval policy; grid-relative coordinates, packed LE u32 material bytes.
+struct Ray { originDistance:vec4<f32>, direction:vec4<f32>, limits:vec4<u32> }
+struct Result { cellKind:vec4<i32>, normalDistance:vec4<f32>, data:vec4<u32>, counts:vec4<u32> }
+@group(0) @binding(0) var<storage,read> pages:array<u32>;
+@group(0) @binding(1) var<storage,read> roots:array<u32>;
+@group(0) @binding(2) var<storage,read> materials:array<u32>;
+@group(0) @binding(3) var<storage,read> meta:array<u32>;
+@group(0) @binding(4) var<storage,read> rays:array<Ray>;
+@group(0) @binding(5) var<storage,read_write> results:array<Result>;
+fn epsilon(a:f32,b:f32)->f32 { return 1e-10*max(1.0,max(abs(a),abs(b))); }
+fn linear(c:vec3<i32>,s:vec3<u32>)->u32 {return u32(c.x)+s.x*(u32(c.y)+s.y*u32(c.z));}
+fn cell_at(o:vec3<f32>,d:vec3<f32>,t:f32)->vec3<i32> {
+ var q=o+t*d;var c=vec3<i32>(floor(q));
+ for(var a=0u;a<3u;a++){if(q[a]==floor(q[a])&&d[a]<0.0){c[a]-=1;}}
+ return c;
+}
+fn next_at(c:vec3<i32>,o:vec3<f32>,d:vec3<f32>)->vec3<f32> {
+ var n=vec3<f32>(1e30);for(var a=0u;a<3u;a++){if(d[a]!=0.0){n[a]=(f32(c[a])+select(0.0,1.0,d[a]>0.0)-o[a])/d[a];}}return n;
+}
+fn answer(kind:i32,c:vec3<i32>,n:vec3<f32>,t:f32,slot:u32,counts:vec4<u32>)->Result {
+ return Result(vec4<i32>(c,kind),vec4<f32>(n,t),vec4<u32>(slot,0u,0u,0u),counts);
+}
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) gid:vec3<u32>) {
+ let ri=gid.x;if(ri>=arrayLength(&rays)){return;}
+ let ray=rays[ri];let o=ray.originDistance.xyz;let d=ray.direction.xyz;let radius=ray.originDistance.w;
+ let size=vec3<u32>(meta[0],meta[1],meta[2]);let ps=vec3<u32>(meta[4],meta[5],meta[6]);let rs=vec3<u32>(meta[8],meta[9],meta[10]);
+ let unknown=meta[3]==1u;let strict=ray.limits.y==1u;let hierarchy=meta[7]==1u;
+ var counts=vec4<u32>(0u);var entry=-1e30;var exit=1e30;var entry_axis=0u;var first=true;var outside=false;var no_line=false;
+ for(var a=0u;a<3u;a++){
+  let hi=f32(size[a]);if(o[a]==0.0){outside=outside||d[a]<0.0;}
+  else if(o[a]==hi){outside=outside||d[a]>=0.0;}else{outside=outside||o[a]<0.0||o[a]>hi;}
+  if(d[a]==0.0){if(o[a]<0.0||o[a]>=hi){no_line=true;}}
+  else{let near=min(-o[a]/d[a],(hi-o[a])/d[a]);let far=max(-o[a]/d[a],(hi-o[a])/d[a]);
+   if(first||near>entry+epsilon(near,entry)){entry=near;entry_axis=a;first=false;}exit=min(exit,far);}
+ }
+ if(unknown&&outside){results[ri]=answer(2,vec3<i32>(-1),vec3<f32>(0),0.0,0u,counts);return;}
+ if(no_line){results[ri]=answer(0,vec3<i32>(-1),vec3<f32>(0),radius,0u,counts);return;}
+ var t=select(0.0,max(0.0,entry),outside);let end=min(exit,radius);
+ if(end-t<=epsilon(end,t)){let budget=strict&&entry>=radius&&exit>entry;
+  results[ri]=answer(select(0,3,budget),vec3<i32>(-1),vec3<f32>(0),radius,0u,counts);return;}
+ var c=cell_at(o,d,t);var n=vec3<f32>(0);if(outside&&entry>0.0){n[entry_axis]=-sign(d[entry_axis]);}
+ var next=next_at(c,o,d);var visited=0u;let can_skip=ray.limits.x>=size.x+size.y+size.z+3u;
+ var last_root=0xffffffffu;var root_empty=false;var last_page=0xffffffffu;var page_code=0u;
+ for(var iteration=0u;iteration<256u;iteration++){
+  if(any(c<vec3<i32>(0))||any(c>=vec3<i32>(size))){break;}
+  var edge=1i;
+  if(hierarchy&&can_skip){let root=linear(c/32,rs);if(root!=last_root){counts.y++;last_root=root;root_empty=roots[root]==0u;}if(root_empty){edge=32;}}
+  if(edge==1){let pi=linear(c/8,ps);if(pi!=last_page){counts.x++;last_page=pi;page_code=pages[pi];}if(can_skip&&page_code==0u){edge=8;}}
+  if(edge>1){
+   var crossing=1e30;for(var a=0u;a<3u;a++){if(d[a]!=0.0){let lo=(c[a]/edge)*edge;let boundary=select(lo,min(i32(size[a]),lo+edge),d[a]>0.0);crossing=min(crossing,(f32(boundary)-o[a])/d[a]);}}
+   counts.w++;if(crossing>=end-epsilon(crossing,end)){break;}t=crossing;c=cell_at(o,d,t);n=vec3<f32>(0);
+   for(var a=0u;a<3u;a++){if(d[a]!=0.0){let incoming=f32(c[a])+select(0.0,1.0,d[a]<0.0);let nt=(incoming-o[a])/d[a];if(abs(nt-t)<=epsilon(nt,t)){n[a]=-sign(d[a]);break;}}}
+   next=next_at(c,o,d);continue;
+  }
+  var slot=0u;if(page_code==1u){slot=255u;}else if(page_code>=2u){
+   let local=c%8;let byte=(page_code-2u)*512u+linear(local,vec3<u32>(8u));slot=(materials[byte/4u]>>((byte%4u)*8u))&255u;}
+  let crossing=min(next.x,min(next.y,next.z));
+  if(min(crossing,end)-t>epsilon(min(crossing,end),t)){
+   if(visited>=ray.limits.x){results[ri]=answer(3,c,n,t,0u,counts);return;}visited++;counts.z++;
+   if(slot==255u){results[ri]=answer(2,c,n,t,0u,counts);return;}if(slot>0u){results[ri]=answer(1,c,n,t,slot,counts);return;}
+  }
+  if(crossing>=end-epsilon(crossing,end)){break;}n=vec3<f32>(0);var picked=false;
+  for(var a=0u;a<3u;a++){if(d[a]!=0.0&&abs(next[a]-crossing)<=epsilon(next[a],crossing)){
+   if(!picked){n[a]=-sign(d[a]);picked=true;}c[a]+=i32(sign(d[a]));next[a]+=1.0/abs(d[a]);}}
+  t=crossing;
+  if(iteration==255u){results[ri]=answer(3,c,n,t,0u,counts);return;}
+ }
+ if(unknown&&exit<radius-epsilon(exit,radius)){results[ri]=answer(2,vec3<i32>(-1),vec3<f32>(0),max(0.0,exit),0u,counts);}
+ else if(strict&&exit>radius+epsilon(exit,radius)){results[ri]=answer(3,vec3<i32>(-1),vec3<f32>(0),radius,0u,counts);}
+ else{results[ri]=answer(0,vec3<i32>(-1),vec3<f32>(0),radius,0u,counts);}
+}
diff --git a/spikes/rt-03-06-hybrid/inputs/rt02b/src/gpu.mts b/spikes/rt-03-06-hybrid/inputs/rt02b/src/gpu.mts
