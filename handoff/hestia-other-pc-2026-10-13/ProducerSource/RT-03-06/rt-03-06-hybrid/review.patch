@@ -0,0 +1,96 @@
+import type { Ray, RayResult, Vec3, Volume } from './types.mts';
+import { validateRay, validateVolume } from './validate.mts';
+
+/** Bound adaptation of fixed-base terrain/picking.ts; no product contract change. */
+export function traceDda(v: Volume, ray: Ray): RayResult {
+  validateVolume(v);
+  validateRay(ray);
+  const inverse = (p: Vec3): Vec3 => [0, 1, 2].map(a =>
+    v.rotation[a]! * p[0] + v.rotation[3 + a]! * p[1] + v.rotation[6 + a]! * p[2]) as Vec3;
+  const origin = inverse(ray.origin.map((n, a) => n - v.translation[a]!) as Vec3);
+  const direction = inverse(ray.direction);
+  if (![...origin, ...direction].every(Number.isFinite)) throw new RangeError('Ray frame transform is not finite');
+  const normalWorld = (n: Vec3): Vec3 => [0, 1, 2].map(a =>
+    v.rotation[a * 3]! * n[0] + v.rotation[a * 3 + 1]! * n[1] + v.rotation[a * 3 + 2]! * n[2]) as Vec3;
+  const miss = (): RayResult => ({ kind: 'Miss', distance: ray.maxDistance, normal: [0, 0, 0],
+    cell: null, materialId: null, materialSource: null, owner: null, cellId: null,
+    sourceRevision: null, sourceGeneration: null, transformGeneration: null, originEpoch: null });
+  const exteriorUnknown = (distance: number): RayResult => ({ ...miss(), kind: 'Unknown', distance,
+    owner: v.binding.owner, sourceRevision: v.binding.sourceRevision, sourceGeneration: v.binding.sourceGeneration,
+    transformGeneration: v.binding.transformGeneration, originEpoch: v.binding.originEpoch });
+  const nearBoundary = (value: number, bound: number, width: number) =>
+    Math.abs(value - bound) <= Math.min(Number.EPSILON * 8 * Math.max(1, Math.abs(value), Math.abs(bound)), width * 1e-6);
+  const startsOutside = origin.some((n, a) => {
+    const lo = v.origin[a]!;
+    const hi = lo + v.size[a]! * v.cellMeters;
+    if (nearBoundary(n, lo, hi - lo)) return direction[a]! < 0;
+    if (nearBoundary(n, hi, hi - lo)) return direction[a]! >= 0;
+    return n < lo || n > hi;
+  });
+  if (v.exteriorCoverage === 'Unknown' && startsOutside) return exteriorUnknown(0);
+  const epsilon = (a: number, b: number) => 1e-10 * Math.max(1, Math.abs(a), Math.abs(b));
+  let entry = -Infinity;
+  let exit = Infinity;
+  let entryAxis = -1;
+  for (let a = 0; a < 3; a++) {
+    const lo = v.origin[a]!;
+    const hi = lo + v.size[a]! * v.cellMeters;
+    const d = direction[a]!;
+    if (d === 0) {
+      if ((origin[a]! < lo && !nearBoundary(origin[a]!, lo, hi - lo))
+        || origin[a]! >= hi || nearBoundary(origin[a]!, hi, hi - lo)) return miss();
+      continue;
+    }
+    const t0 = (lo - origin[a]!) / d;
+    const t1 = (hi - origin[a]!) / d;
+    const near = Math.min(t0, t1);
+    const far = Math.max(t0, t1);
+    if (entryAxis < 0 || near > entry + epsilon(near, entry)) { entry = near; entryAxis = a; }
+    exit = Math.min(exit, far);
+  }
+  let distance = startsOutside ? Math.max(0, entry) : 0;
+  const end = Math.min(exit, ray.maxDistance);
+  const ended = (): RayResult => v.exteriorCoverage === 'Unknown' && exit < ray.maxDistance - epsilon(exit, ray.maxDistance) ? exteriorUnknown(Math.max(0, exit)) : miss();
+  if (end - distance <= epsilon(end, distance)) return miss();
+  const step = direction.map(Math.sign);
+  const q = origin.map((n, a) => (n + distance * direction[a]! - v.origin[a]!) / v.cellMeters);
+  const cell = q.map((n, a) => {
+    const rounded = Math.round(n);
+    const position = origin[a]! + distance * direction[a]!;
+    const boundary = v.origin[a]! + rounded * v.cellMeters;
+    const value = nearBoundary(position, boundary, v.cellMeters) ? rounded : n;
+    return (Math.floor(value) - (direction[a]! < 0 && Number.isInteger(value) ? 1 : 0)) || 0;
+  }) as Vec3;
+  const delta = direction.map(d => d === 0 ? Infinity : v.cellMeters / Math.abs(d));
+  const next = direction.map((d, a) => d === 0 ? Infinity :
+    (v.origin[a]! + (cell[a]! + (step[a]! > 0 ? 1 : 0)) * v.cellMeters - origin[a]!) / d);
+  let normal: Vec3 = [0, 0, 0];
+  if (startsOutside && entry > 0) normal[entryAxis] = -step[entryAxis]!;
+  let visited = 0;
+  while (distance < end) {
+    if (cell.some((n, a) => n < 0 || n >= v.size[a]!)) return ended();
+    const index = cell[0] + v.size[0] * (cell[1] + v.size[1] * cell[2]);
+    const slot = v.cells[index]!;
+    const crossing = Math.min(...next);
+    const result = (kind: RayResult['kind']): RayResult => ({ kind, distance, normal: normalWorld(normal),
+      cell: [...cell], materialId: kind === 'Hit' ? slot : null,
+      materialSource: kind === 'Hit' ? v.materials.find(m => m.id === slot)!.source : null,
+      owner: v.binding.owner, cellId: v.cellIds[index]!, sourceRevision: v.binding.sourceRevision,
+      sourceGeneration: v.binding.sourceGeneration, transformGeneration: v.binding.transformGeneration,
+      originEpoch: v.binding.originEpoch });
+    // Sub-tolerance slivers are not positive intervals and consume no cell budget.
+    if (Math.min(crossing, end) - distance > epsilon(Math.min(crossing, end), distance)) {
+      if (visited >= ray.maxSteps) return result('BudgetExceeded');
+      visited++;
+      if (slot === -1) return result('Unknown');
+      if (slot > 0) return result('Hit');
+    }
+    if (crossing >= end - epsilon(crossing, end)) return ended();
+    const tied = next.map((n, a) => Number.isFinite(n) && Math.abs(n - crossing) <= epsilon(n, crossing) ? a : -1).filter(a => a >= 0);
+    normal = [0, 0, 0];
+    normal[tied[0]!] = -step[tied[0]!]!;
+    for (const a of tied) { cell[a]! += step[a]!; next[a]! += delta[a]!; }
+    distance = crossing;
+  }
+  return ended();
+}
diff --git a/spikes/rt-03-06-hybrid/inputs/rt02b/imported/rt01/src/types.mts b/spikes/rt-03-06-hybrid/inputs/rt02b/imported/rt01/src/types.mts
