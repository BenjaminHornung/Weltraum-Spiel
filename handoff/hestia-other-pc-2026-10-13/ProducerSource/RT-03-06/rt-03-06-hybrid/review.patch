+ const manifest=await checked('./fixtures/manifest.json',expectedFixture),files=new Map<string,any>();
+ for(const row of manifest.files)if(row.path.startsWith('voxels/')&&row.path.endsWith('.json')||row.path==='rays/golden-1000.json')files.set(row.path,await checked('./fixtures/'+row.path,row.sha256));
