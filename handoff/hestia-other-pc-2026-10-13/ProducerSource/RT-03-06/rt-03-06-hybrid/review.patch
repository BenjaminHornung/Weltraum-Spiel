+ const bindingResponse=await fetch('./binding-manifest.json'),bindingBytes=new Uint8Array(await bindingResponse.arrayBuffer());if(await digest(bindingBytes)!==manifestRef.sha256)throw new Error('Full payload manifest drift');const binding=JSON.parse(new TextDecoder().decode(bindingBytes));
+ const proofResponse=await fetch('./build-proof.json'),proofBuffer=await proofResponse.arrayBuffer(),proofBytes=new Uint8Array(proofBuffer),proofRef=binding.files.find((r:any)=>r.path==='spikes/rt-03-06-hybrid/dist/build-proof.json');if(!proofRef||await digest(proofBytes)!==proofRef.sha256)throw new Error('Unsealed built runtime');
+ const input=await inputs(),profile=await fetch('./repro-profile.json').then(r=>r.arrayBuffer()),profileSha256=await digest(new Uint8Array(profile));
+ if(profileSha256!==lease.profileSha256)throw new Error('Profile bytes drift');
+ const proof=JSON.parse(new TextDecoder().decode(proofBytes));
+ const shader=async(name:string)=>{const ref=proof.inputs.find((r:any)=>r.path===name);if(!ref)throw new Error('Unbound shader');const response=await fetch('./'+name),b=new Uint8Array(await response.arrayBuffer());if(await digest(b)!==ref.sha256)throw new Error('Shader bytes drift');return new TextDecoder().decode(b);};
+ return runHardwareProfile(host,{...input,profileSha256,sealSha256:lease.sealSha256,ddaShader:await shader('inputs/rt02b/src/dda.wgsl'),composeShader:await shader('src/compose.wgsl')},lease);
+}
+Object.assign(window,{RT0306:Object.freeze({runCpuBrowser,runBoundHardware})});
+document.querySelector('#cpu')?.addEventListener('click',async()=>{const status=document.querySelector('#status');if(status)status.textContent='CPU diagnostic running; GPU NOT_RUN';try{const r=await runCpuBrowser();if(status)status.textContent=JSON.stringify(r,null,2);}catch(e){if(status)status.textContent='FAIL '+String(e);}});
