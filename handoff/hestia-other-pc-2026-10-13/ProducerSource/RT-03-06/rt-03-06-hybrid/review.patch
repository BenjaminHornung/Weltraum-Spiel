+    }catch(e){bvh.dispose();dda?.dispose();throw e;}
+   }
+   live();const candidate=new PreparedProjection(this.#token,serial,epoch,owners,pages);this.#pending=candidate;return candidate;
+  }catch(e){for(const o of owners){o.bvh.dispose();o.dda.dispose();}throw e;}finally{this.#preparing=false;}
+ }
