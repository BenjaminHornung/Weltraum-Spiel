+it("PLAY04 binds the R03 CABLE5500 split to v5 and the unchanged light C07 custody",()=>{
+ const profile=readCargoHandlingProfile(fixture.catalog,"CABLE5500")!;
+ expect(profile).toMatchObject({terms:[{itemId:"fp02.comp.field_cable",quantityUnits:5500}],massMg:1_375_000,capacityMm3:16_500_000,sizeMm:[500,1000,500]});
+ expect(profile.sourceRefs).toContain("fp06-technical-s0-closed-native-socket-cable-jobs-v5");
+ const plannedLengths=[8500,5250,2750,8000,profile.terms[0]!.quantityUnits],used=plannedLengths.reduce((total,length)=>total+length,0);
+ expect(used).toBe(30_000);expect(40_000-used).toBe(10_000);
+ const material=setup(),source=material.containers.find(c=>c.state.containerId===fixture.resourceState.containerId)!,cable=fixture.catalog.items.find(i=>i.sourceId==="fp02.comp.field_cable")!,stack=source.state.contents.find(s=>s.resourceId===cable.resourceId)!;
+ const request={...intent,commandId:"pay_cable5500_v5",profileId:"CABLE5500",expectedMaterialRevision:material.revision,sourceLots:[{containerId:source.state.containerId,stackId:stack.stackId,quantityUnits:5500}]};
+ const plan=prepareCargoHandling(material,request);expect(plan.status).toBe("Prepared");if(plan.status!=="Prepared")throw Error(plan.reason);
+ expect(plan.profile).toMatchObject({terms:profile.terms,massMg:1_375_000,capacityMm3:16_500_000});
+ expect(prepareCargoHandling(material,{...request,sourceLots:[{...request.sourceLots[0]!,quantityUnits:5499}]})).toMatchObject({status:"Rejected",reason:"HandlingProfileTermsMismatch"});
+ expect(readCargoHandlingProfile(fixture.catalog,"CABLE5501")).toBeUndefined();
+});
