+    // the existing Native transaction. No renderer, pose or clock injection.
+    const ownerId = "hvp:terrain-fragment:r1:1234abcd";
+    const eyeY = native.read().player!.position.y + HVP_PLAYER_PROFILE.eyeHeight - HVP_PLAYER_PROFILE.height / 2;
+    const contactY = Math.floor((eyeY - HVP_SOURCE_MIN_METERS.y) / 0.125);
+    native.prepareTerrain("input_cut_contact", 0, [{ index: 0, mesh: supportedGround() }], [{ ownerId,
+      cells: [127, 128, 129].map(x => ({ x, y: contactY, z: 144, materialId: 1 })),
+      origin: HVP_SOURCE_MIN_METERS, massKg: 3 * 2400 * 0.125 ** 3 }]);
+    native.commitTerrain("input_cut_contact"); native.finalizeTerrain("input_cut_contact");
+    client.update(); worker.release(); await turn();
+    const fragment = native.read().terrainFragments.find(part => part.ownerId === ownerId)!;
+    expect(fragment).toBeDefined(); expect(native.read().player!.grounded).toBe(true);
+    const request = { id: `input_cut_${boundary.toLowerCase()}`, ownerId, sourceDigest: fragment.sourceDigest,
+      edge: 1, direction: { x: 0, y: 0, z: 1 } };
