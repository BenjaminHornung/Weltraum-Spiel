+    expect(preparation.payload).toMatchObject({ ownerId, sourceDigest: fragment.sourceDigest, commandId: request.id });
+    expect(native.read()).toMatchObject({ status: "Running", moving: { state: "Preparing", pendingId: request.id } });
+    expect(native.read().ticks).toBe(before.ticks); expect(native.read().player!.position).toEqual(before.player!.position);
+    if (boundary === "Client") client.setPlayerInput(zero);
