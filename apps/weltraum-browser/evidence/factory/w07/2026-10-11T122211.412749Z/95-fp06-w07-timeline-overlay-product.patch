@@ -0,0 +1,335 @@
+import { afterEach, beforeAll, describe, expect, it, vi } from "vitest";
+import { PerspectiveCamera } from "three";
+import { createHvpPlayerInput } from "../../src/hestia-prototype/player/input";
+import { createHvpPhysicsClient, type HvpPhysicsClient } from "../../src/hestia-prototype/physics/client";
+import { createHvpPhysicsSession, type HvpPhysicsSession } from "../../src/hestia-prototype/physics/session";
+import { initializeHvpRapier } from "../../src/hestia-prototype/physics/rapierPort";
+import { HVP_PLAYER_PROFILE, type HvpPlayerInput } from "../../src/hestia-prototype/player/locomotion";
+import type { HvpPhysicsMessage, HvpPhysicsReply } from "../../src/hestia-prototype/physics/physicsWorker";
+import { createFp02Fixture } from "../../src/factory/catalog/fp02Catalog";
+import { HVP_SOURCE_MIN_METERS } from "../../src/hvp/hvpCoastSource";
+
+// Explicit transport harness only: empty sources need no collision jobs. Native
+// snapshots below come from real Rapier sessions; no simulated axis pose or tick.
+vi.mock("../../src/workers/workerPool", () => ({ WorkerPool: class {
+  async start() {} async shutdown() {}
+} }));
+beforeAll(initializeHvpRapier);
+const cleanup: (() => void | Promise<void>)[] = [];
+afterEach(async () => { for (const close of cleanup.splice(0).reverse()) await close(); vi.unstubAllGlobals(); });
+const turn = async () => { await Promise.resolve(); await Promise.resolve(); await Promise.resolve(); };
+const zero = { x: 0, z: 0, sprint: false, jump: false };
+const supportedGround = () => ({ vertices: new Float32Array([-4, 0, -4, -4, 0, 4, 4, 0, 4, 4, 0, -4]),
+  indices: new Uint32Array([0, 1, 2, 0, 2, 3]) });
+// Before the dedicated Factory boundary exists, use the actual old Native
+// input setter. That yields collected behavioral assertions, not missing-API
+// errors. Afterwards the exact new Native authority method is exercised.
+const nativeFactoryIntent = (session: HvpPhysicsSession, value: HvpPlayerInput, cancel = false): boolean => {
+  const port = session as HvpPhysicsSession & { factoryInput?: (input: HvpPlayerInput, cancel: boolean) => boolean };
+  if (port.factoryInput) return port.factoryInput(value, cancel);
+  session.input(value); return true;
+};
+class Element extends EventTarget {
+  id = ""; open = false; textContent = ""; dataset: Record<string, string> = {};
+  setAttribute() {} append() {} remove() {} focus() {} showModal() { this.open = true; } close() { this.open = false; }
+}
+const inputHarness = async (factory = true) => {
+  const native = await createHvpPhysicsSession([], { x: 10, y: 4, z: 10 }, undefined,
+    { spawn: { x: 0, y: 2, z: 0 }, coverage: [{ minX: -16, minZ: -16, maxX: 16, maxZ: 16 }] });
+  const doc = Object.assign(new EventTarget(), { body: new Element(), hidden: false, pointerLockElement: null as Element | null,
+    createElement: () => new Element(), exitPointerLock: () => { doc.pointerLockElement = null; doc.dispatchEvent(new Event("pointerlockchange")); } });
+  const canvas = Object.assign(new Element(), { requestPointerLock: async () => { doc.pointerLockElement = canvas; doc.dispatchEvent(new Event("pointerlockchange")); } });
+  const win = new EventTarget(); const intents: HvpPlayerInput[] = []; let blocked = false;
+  const physics = { read: () => native.read(), setPlayerInput: (value: HvpPlayerInput) => { intents.push({ ...value }); native.input(value); },
+    setCameraOffset: () => {}, command: async (kind: string) => { if (kind === "Play") native.play(); if (kind === "Pause") native.pause(); } } as unknown as HvpPhysicsClient;
+  // The ninth opt-in is deliberately ignored by the old implementation, making
+  // the initial RED a collected business assertion rather than an import failure.
+  const create = createHvpPlayerInput as unknown as (...args: unknown[]) => ReturnType<typeof createHvpPlayerInput>;
+  const input = create(canvas, new PerspectiveCamera(), physics, doc, win, () => {}, { confirm() {}, select() {} }, () => blocked, factory);
+  cleanup.push(() => { input.dispose(); native.dispose(); });
+  input.start(); await turn();
+  const key = (type: string, code: string, repeat = false) => win.dispatchEvent(Object.assign(new Event(type, { cancelable: true }), { code, repeat }));
+  return { input, native, intents, key, win, block: () => { blocked = true; } };
+};
+
+describe("W07 Factory event intent without render authority", () => {
+  it("delivers normal Factory KeyD without any RAF and releases it before a frame", async () => {
+    const h = await inputHarness(); const ticks = h.native.read().ticks;
+    h.key("keydown", "KeyD"); expect(h.intents).toHaveLength(1); expect(h.intents[0]!.x).toBeCloseTo(-1);
+    h.key("keyup", "KeyD"); expect(h.intents.at(-1)).toMatchObject(zero); expect(h.native.read().ticks).toBe(ticks);
+  });
+  it("stages one Space edge, preserves it through ordinary release, and never stages it again on RAF", async () => {
+    const h = await inputHarness(); h.key("keydown", "Space"); expect(h.intents.at(-1)?.jump).toBe(true);
+    h.key("keydown", "Space", true); h.key("keyup", "Space"); h.input.update();
+    expect(h.intents.filter(value => value.jump)).toHaveLength(1);
+  });
+  it.each(["Escape", "blur", "hold"])("neutralizes staged movement and jump at %s without another RAF", async kind => {
+    const h = await inputHarness(); h.key("keydown", "KeyD"); h.key("keydown", "Space"); expect(h.intents.at(-1)?.jump).toBe(true);
+    if (kind === "Escape") h.key("keydown", "Escape"); else if (kind === "blur") h.win.dispatchEvent(new Event("blur")); else { h.block(); h.key("keyup", "KeyD"); }
+    expect(h.intents.at(-1)).toMatchObject(zero); expect(h.input.active).toBe(false);
+  });
+  it("keeps the unextended Legacy input deferred to the existing RAF path", async () => {
+    const h = await inputHarness(false); h.key("keydown", "KeyD"); expect(h.intents).toEqual([]); h.input.update(); expect(h.intents.at(-1)!.x).toBeCloseTo(-1);
+  });
+});
+
+class NativeTransport {
+  static current: NativeTransport;
+  onmessage: ((event: MessageEvent<HvpPhysicsReply>) => void) | null = null;
+  onerror = null; onmessageerror = null; terminated = false;
+  messages: HvpPhysicsMessage[] = []; reads: HvpPhysicsMessage[] = []; session!: HvpPhysicsSession;
+  supportedFixture = false;
+  holdInputAcks=false;inputAcks:number[]=[];
+  constructor() { NativeTransport.current = this; }
+  postMessage(message: HvpPhysicsMessage) {
+    this.messages.push(structuredClone(message));
+    void (async () => {
+      if (message.kind === "Initialize") this.session = await createHvpPhysicsSession(this.supportedFixture ? [supportedGround()]
+        : message.sectors, message.spawn, message.gravity, this.supportedFixture ? {
+        spawn: { x: 0, y: 0.92, z: 0 }, coverage: [{ minX: -4, minZ: -4, maxX: 4, maxZ: 4 }]
+      } : message.player, message.inertiaSpawn, message.branchSpawn, message.sessionId, undefined, message.branchKind, message.factoryEnabled);
+      else if (message.kind === "Read") { if (message.input) this.session.input(message.input); this.reads.push(message); return; }
+      else if(message.kind==="FactoryInput"){
+        this.session.factoryInput(message.input,message.cancelPendingJump);
+        if(this.holdInputAcks)this.inputAcks.push(message.id);else this.onmessage?.(new MessageEvent("message",{data:{id:message.id}}));
+        return;
+      }
+      else if (message.kind === "Pause") this.session.pause();
+      else if (message.kind === "Play") this.session.play();
+      else if (message.kind === "BeginBodyCut") { this.reply(message.id, this.session.beginBodyCut(message.request)); return; }
+      else if (message.kind === "RollbackBodyCut") this.session.rollbackBodyCut(message.transactionId);
+      else if (message.kind === "PrepareFactoryFacility") this.session.prepareFactoryFacility(message.request);
+      else if (message.kind === "CommitFactoryFacility") this.session.commitFactoryFacility(message.transactionId);
+      else if (message.kind === "RollbackFactoryFacility") this.session.rollbackFactoryFacility(message.transactionId);
+      else if (message.kind === "Dispose") this.session.dispose();
+      this.reply(message.id);
+    })().catch(error => { this.onmessage?.({ data: { id: message.id, rejected: String(error) } } as MessageEvent<HvpPhysicsReply>); });
+  }
+  reply(id: number, bodyPreparation?: HvpPhysicsReply["bodyPreparation"]) { this.onmessage?.(new MessageEvent<HvpPhysicsReply>("message", { data: { id, ...(bodyPreparation ? { bodyPreparation } : {}), snapshot: this.session.read(), clock: { timers: 0, maxTimerGapMs: 0, maxAdvanceMs: 0,
+    maxHandlerMs: 0, lastCommand: "explicit-native-transport-fixture", lastHandlerMs: 0, delayedCallbacks: [] } } })); }
+  release() { const message = this.reads.shift(); if (!message) throw new Error("Missing held test Read"); this.reply(message.id); }
+  terminate() { this.terminated = true; this.session?.dispose(); }
+}
+const clientHarness = async (factory = true, supported = false, onTimings?:(batch:NonNullable<HvpPhysicsReply["timings"]>)=>void) => {
+  vi.stubGlobal("Worker", supported ? class extends NativeTransport { supportedFixture = true; } : NativeTransport);
+  const client = await createHvpPhysicsClient([], { x: 10, y: 4, z: 10 }, new AbortController().signal,
+    { x: 0, y: 2, z: 0 }, undefined, undefined, undefined, "branch", onTimings, factory);
+  const worker = NativeTransport.current; cleanup.push(() => client.dispose()); return { client, worker };
+};
