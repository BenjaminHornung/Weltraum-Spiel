+  const released=new Promise<void>(resolve=>setTimeout(resolve,ms)).then(()=>keyboard.send("Input.dispatchKeyEvent",up));const failures:unknown[]=[];
+  try{for(const r of await Promise.allSettled([down,released]))if(r.status==="rejected")failures.push(r.reason);}finally{try{await keyboard.send("Input.dispatchKeyEvent",up);}catch(error){failures.push(error);try{await context.close();}catch(error){failures.push(error);}}}
+  if(failures.length===1)throw failures[0];if(failures.length)throw new AggregateError(failures,"Normal key release failed");
+ };
+ const caps={x:300,z:300};
+ const walk=async(axis:"x"|"z",target:number)=>{
+  for(let i=0;i<4;i++){const before=await native(page),v=before.player.position[axis];if(Math.abs(v-target)<=.08)break;const key=axis==="x"?(v>target?"d":"a"):(v>target?"s":"w"),ms=Math.max(25,Math.min(caps[axis],Math.round(Math.abs(v-target)/3*1000)));await press(key,ms);let after=before,stableReads=0;for(let read=0;read<4;read++){await page.waitForTimeout(100);const next=await native(page),stable=next.ticks>after.ticks&&Math.abs(next.player.position.x-after.player.position.x)<1e-6&&Math.abs(next.player.position.z-after.player.position.z)<1e-6;stableReads=stable?stableReads+1:0;after=next;if(stableReads>=2)break;}expect(stableReads,"Released movement must settle in fresh native snapshots before another gesture").toBeGreaterThanOrEqual(2);if((v-target)*(after.player.position[axis]-target)<0)caps[axis]=Math.max(25,Math.round(caps[axis]/2));events.push({axis,target,key,ms,before,after});await writeFile(path.join(run,"heavy-route-taps.json"),JSON.stringify(events,null,2)+"\n");}
