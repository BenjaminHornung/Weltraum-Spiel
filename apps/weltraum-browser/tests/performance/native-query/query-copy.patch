     /// Initializes a new empty broad-phase.
     pub fn new() -> Self {
         Self::default()
+    }
+
+    /// Publish current geometry to a detached query-only tree. The solver owns its
+    /// own tree, pair adjacency and change lists; queries never consume them.
+    pub fn publish_query_copy(
+        &self,
+        target: &mut Option<Self>,
+        params: &IntegrationParameters,
+        colliders: &ColliderSet,
+    ) {
+        // The WASM physics pipeline discards the previous projection on step/restore.
+        // The solver tree is then the canonical base. Copy the spatial nodes only.
+        let queries = target.get_or_insert_with(|| {
+            let mut query = Self::new();
+            query.tree = self.tree.clone();
+            query
+        });
+        // An arena slot can be reused at a new generation before the next step.
+        // Remove all old slots first, then resolve each live generational handle.
+        for handle in &colliders.removed_colliders {
+            queries.tree.remove(handle.into_raw_parts().0);
+        }
+        for handle in colliders.modified_colliders.iter() {
+            if let Some(collider) = colliders.get(*handle) {
+                if collider.is_enabled() {
+                    queries.set_aabb(params, *handle, collider.compute_aabb());
+                } else {
+                    queries.tree.remove(handle.into_raw_parts().0);
+                }
+            }
+        }
+        // This query-only broad phase will never generate a contact pair.
+        queries.pending_set_aabb.clear();
     }
 
