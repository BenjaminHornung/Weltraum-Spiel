{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"], "strict": true, "skipLibCheck": false,
    "rootDir": ".", "outDir": "dist", "declaration": true,
    "noEmitOnError": true, "types": []
