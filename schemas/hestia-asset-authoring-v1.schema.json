{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weltraum.invalid/schemas/hestia-asset-authoring-v1.schema.json",
  "title": "Hestia Asset Authoring Contract V1 (closed canonical authoring root)",
  "description": "Draft 2020-12 schema for the in-memory canonical Hestia v1 authoring root. GLB transport metadata such as node extras.kind is removed before this schema is applied; unknown canonical fields fail closed. Registry binding is compiler configuration, not authoring data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "asset",
    "parts",
    "joints",
    "markers",
    "materials"
  ],
  "properties": {
    "schema": {
      "description": "The exact Hestia authoring schema discriminator. There is no v1 aliasing or migration.",
      "const": "hestia.asset-authoring.v1"
    },
    "asset": {
      "description": "Canonical asset metadata collected from asset.extras.hestia. Source GLB/Blender state is not persisted by canonicalization.",
      "$ref": "#/$defs/asset"
    },
    "parts": {
      "description": "Canonical part records. Transport node extras.kind is not a member of these records.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "joints": {
      "description": "Canonical joint records. Transport node extras.kind is not a member of these records.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/joint"
      }
    },
    "markers": {
      "description": "Canonical marker records. Transport node extras.kind is not a member of these records.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/marker"
      }
    },
    "materials": {
      "description": "Canonical render-material entries. Render IDs resolve in this array; structural IDs resolve only in the external compiler-pinned registry.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/material"
      }
    }
  },
  "$defs": {
    "id": {
      "description": "Case-sensitive opaque v1 identifier syntax. Values are not trimmed or otherwise normalized by the schema.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "representation": {
      "enum": [
        "Solid",
        "Shell",
        "LayeredShell",
        "StructuralAssembly",
        "ModularPart",
        "Decorative",
        "Hybrid"
      ]
    },
    "coordinateFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upAxis",
        "forwardAxis",
        "handedness"
      ],
      "properties": {
        "upAxis": {
          "const": "+Y"
        },
        "forwardAxis": {
          "const": "+Z"
        },
        "handedness": {
          "const": "RIGHT"
        }
      }
    },
    "tags": {
      "description": "Optional ID-shaped tags. Empty arrays are valid and uniqueItems rejects duplicates; semantic canonicalization sorts tags lexically.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "asset": {
      "description": "Required canonical asset fields. defaultStructuralMaterialId is a globally namespaced opaque external-registry ID, not a materials-array ID.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "assetRevision",
        "representation",
        "metersPerUnit",
        "coordinateFrame"
      ],
      "properties": {
        "assetId": {
          "$ref": "#/$defs/id"
        },
        "assetRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "representation": {
          "$ref": "#/$defs/representation"
        },
        "metersPerUnit": {
          "const": 1
        },
        "coordinateFrame": {
          "$ref": "#/$defs/coordinateFrame"
        },
        "defaultStructuralMaterialId": {
          "$ref": "#/$defs/id"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        }
      }
    },
    "thinFeature": {
      "description": "Authored thin-feature policy and positive declared minimum thickness. Geometry measurement remains compiler-owned.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "declaredMinimumThicknessMeters"
      ],
      "properties": {
        "policy": {
          "enum": [
            "Reject",
            "PreserveAsBeam",
            "PreserveAsRod",
            "PreserveAsShell",
            "DecorativeOnly"
          ]
        },
        "declaredMinimumThicknessMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "shellLayer": {
      "description": "A shell layer whose structural material ID is resolved through the external registry, never through canonical render materials.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structuralMaterialId",
        "thicknessMeters"
      ],
      "properties": {
        "structuralMaterialId": {
          "$ref": "#/$defs/id"
        },
        "thicknessMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "shell": {
      "description": "Shell metadata required for Shell and LayeredShell parts. It does not persist source geometry or compiler registry data.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thicknessMeters",
        "layers"
      ],
      "properties": {
        "thicknessMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shellLayer"
          },
          "minItems": 1
        }
      }
    },
    "part": {
      "description": "Closed canonical part object. Transport-only kind and unknown Hestia fields are invalid. Decorative parts additionally require destructible false and collisionPolicy None or AuthoredMesh.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partId",
        "representation",
        "destructible",
        "collisionPolicy",
        "navigationPolicy",
        "thinFeature"
      ],
      "properties": {
        "partId": {
          "$ref": "#/$defs/id"
        },
        "parentPartId": {
          "$ref": "#/$defs/id"
        },
        "representation": {
          "$ref": "#/$defs/representation"
        },
        "defaultRenderMaterialId": {
          "description": "Render-material ID resolved exactly once against one canonical materials entry.",
          "$ref": "#/$defs/id"
        },
        "structuralMaterialId": {
          "description": "Opaque globally namespaced structural-material ID resolved only through the compiler-pinned external registry.",
          "$ref": "#/$defs/id"
        },
        "destructible": {
          "type": "boolean"
        },
        "collisionPolicy": {
          "enum": [
            "None",
            "AuthoredMesh",
            "Compound",
            "Voxel"
          ]
        },
        "navigationPolicy": {
          "enum": [
            "None",
            "Obstacle",
            "Walkable",
            "Portal"
          ]
        },
        "thinFeature": {
          "$ref": "#/$defs/thinFeature"
        },
        "shell": {
          "$ref": "#/$defs/shell"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "representation": {
                "const": "Shell"
              }
            },
            "required": [
              "representation"
            ]
          },
          "then": {
            "required": [
              "shell"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "representation": {
                "const": "LayeredShell"
              }
            },
            "required": [
              "representation"
            ]
          },
          "then": {
            "required": [
              "shell"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "representation": {
                "const": "Decorative"
              }
            },
            "required": [
              "representation"
            ]
          },
          "then": {
            "properties": {
              "destructible": {
                "const": false
              },
              "collisionPolicy": {
                "enum": [
                  "None",
                  "AuthoredMesh"
                ]
              }
            }
          }
        }
      ]
    },
    "joint": {
      "description": "Closed canonical joint object assembled from a classified transport node; transport kind is not retained.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jointId",
        "parentPartId",
        "childPartId",
        "jointType",
        "breakPolicy"
      ],
      "properties": {
        "jointId": {
          "$ref": "#/$defs/id"
        },
        "parentPartId": {
          "$ref": "#/$defs/id"
        },
        "childPartId": {
          "$ref": "#/$defs/id"
        },
        "jointType": {
          "enum": [
            "Fixed",
            "Hinge",
            "Slider",
            "Breakable"
          ]
        },
        "breakPolicy": {
          "enum": [
            "Never",
            "Threshold",
            "Scripted"
          ]
        },
        "breakForceNewtons": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "breakTorqueNewtonMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tags": {
          "$ref": "#/$defs/tags"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "breakPolicy": {
                "const": "Threshold"
              }
            },
            "required": [
              "breakPolicy"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "breakForceNewtons"
                ]
              },
              {
                "required": [
                  "breakTorqueNewtonMeters"
                ]
              }
            ]
          }
        }
      ]
    },
    "marker": {
      "description": "Closed canonical marker object assembled from a classified transport node; transport kind is not retained.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "markerId",
        "markerType"
      ],
      "properties": {
        "markerId": {
          "$ref": "#/$defs/id"
        },
        "markerType": {
          "enum": [
            "Snap",
            "Docking",
            "Cargo",
            "Interaction",
            "Story",
            "Spawn",
            "CutInterface",
            "ToolMount",
            "Seat"
          ]
        },
        "partId": {
          "$ref": "#/$defs/id"
        },
        "interfaceId": {
          "$ref": "#/$defs/id"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "markerType": {
                "const": "CutInterface"
              }
            },
            "required": [
              "markerType"
            ]
          },
          "then": {
            "required": [
              "interfaceId"
            ]
          }
        }
      ]
    },
    "material": {
      "description": "Closed canonical material entry. renderMaterialId must be unique and resolve exactly once in the canonical materials array; structuralMaterialId is external-registry-only.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "renderMaterialId"
      ],
      "properties": {
        "renderMaterialId": {
          "description": "The sole render-material identifier for this entry and the key used for exact render-reference resolution.",
          "$ref": "#/$defs/id"
        },
        "structuralMaterialId": {
          "description": "Opaque globally namespaced structural-material ID resolved only through the compiler-pinned external registry.",
          "$ref": "#/$defs/id"
        },
        "paletteIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "tags": {
          "$ref": "#/$defs/tags"
        }
      }
    }
  }
}
